# Scout AI provider — OpenAI-compatible. Groq is the recommended free tier:
# fast, free key at https://console.groq.com, no card. 131K context, strong at
# structured JSON (which Scout relies on for dossiers, fit, and outreach).
# Gemini free tier is the fallback (resets daily):
#   AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   AI_MODEL=gemini-3.5-flash

AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1/
AI_MODEL=llama-3.3-70b-versatile

# --- Auth (Supabase + Google OAuth) ---
# Both are sent to the browser. The publishable key is public by design; RLS is
# what protects the data. Enable Google under Authentication → Providers in the
# Supabase dashboard, and add <origin>/auth/callback to the redirect allowlist.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Comma-separated allowlist of Google addresses permitted to sign in. Any Google
# account can complete the OAuth flow, so this is the actual gate.
# EMPTY = NOBODY GETS IN — it fails closed by design.
AUTH_ALLOWED_EMAILS=you@example.com

# Optional: pin the OAuth callback origin. Leave unset to derive it from the
# request host, which is correct for both localhost and a normal deployment.
# NEXT_PUBLIC_SITE_URL=https://scout.example.com

# Exa research (free tier: $20 new-account credits + $10/mo recurring).
# Get a key at https://dashboard.exa.ai/ — used for company discovery searches.
# Optional for v1: without it, research uses only the URLs you paste.
EXA_API_KEY=

# Supabase Postgres. Copy both strings from the dashboard:
#   Project Settings → Database → Connection string
#
#   DATABASE_URL = "Transaction pooler"  (port 6543) — the app runs on this.
#   DIRECT_URL   = "Session pooler"      (port 5432) — `prisma migrate` runs on
#                  this; the transaction pooler breaks migration advisory locks.
#
# Both pooler hosts are IPv4. Do NOT use db.<ref>.supabase.co — it is IPv6-only
# and will fail from Vercel and most CI runners.
#
# Keep `uselibpqcompat=true&sslmode=require` on both. It means "encrypt, don't
# verify the cert" (libpq semantics). Without uselibpqcompat, node-postgres v8
# reads sslmode=require as verify-full and rejects Supabase's self-signed chain;
# with no sslmode at all the connection is silently UNENCRYPTED.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?uselibpqcompat=true&sslmode=require"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?uselibpqcompat=true&sslmode=require"

# Alternatives that speak the same protocol:
# OpenRouter:  https://openrouter.ai/api/v1/          model: deepseek/deepseek-chat:free
# OpenAI:      https://api.openai.com/v1/             model: gpt-5.6-luna
