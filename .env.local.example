# Scout AI provider — OpenAI-compatible. Defaults to Google's Gemini free tier.
# 1. Get a free key at https://aistudio.google.com/apikey
# 2. Copy this file to .env.local and fill in the key
# 3. (Optional) swap base URL/model to use Groq, OpenRouter, DeepSeek, or OpenAI.

AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_MODEL=gemini-3.5-flash

# Local Postgres (docker compose up -d). Port 5433 avoids conflicts with a
# system Postgres that may already be on 5432.
DATABASE_URL="postgresql://scout:scout@localhost:5433/scout"

# Optional: raise the GitHub API rate limit for GitHub evidence analysis
# GITHUB_TOKEN=ghp_your_token

# Alternatives that speak the same protocol:
# Groq:        https://api.groq.com/openai/v1/        model: llama-3.3-70b-versatile
# OpenRouter:  https://openrouter.ai/api/v1/          model: deepseek/deepseek-chat:free
# OpenAI:      https://api.openai.com/v1/             model: gpt-5.6-luna
